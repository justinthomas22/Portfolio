{% extends 'base.html.twig' %}

{% block title %}Contact - Thomas JUSTIN{% endblock %}

{% block body %}
<section class="contact-section">
    <div class="contact-intro">
        <p class="subtitle">PRENONS CONTACT</p>
        <h1>Me contacter</h1>
        <p>
            Une question, une opportunité ou simplement envie d'échanger ?
            Écrivez-moi via le formulaire ou retrouvez-moi sur mes réseaux.
        </p>
    </div>

    <div class="contact-layout">
        <div class="contact-form-column">
            {% if message_sent %}
                <p class="form-feedback form-feedback-success">
                    Votre message a été envoyé avec succès. Merci pour votre prise de contact !
                </p>
            {% endif %}

            <form class="contact-form" action="https://api.web3forms.com/submit" method="post">
            <input type="hidden" name="access_key" value="{{ web3forms_access_key }}">
            <input type="hidden" name="redirect" value="{{ absolute_url(path('app_contact')) }}?sent=1">
            <div class="form-row">
                <label for="contact-nom">Nom</label>
                <input id="contact-nom" name="nom" type="text" autocomplete="family-name" required>
            </div>

            <div class="form-row">
                <label for="contact-prenom">Prénom</label>
                <input id="contact-prenom" name="prenom" type="text" autocomplete="given-name" required>
            </div>

            <div class="form-row">
                <label for="contact-email">Email</label>
                <input id="contact-email" name="email" type="email" autocomplete="email" required>
            </div>

            <div class="form-row">
                <label for="contact-sujet">Sujet</label>
                <input id="contact-sujet" name="subject" type="text" required>
            </div>

            <div class="form-row">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="message" rows="6" required></textarea>
            </div>

                <button type="submit" class="contact-submit">Envoyer le message <span aria-hidden="true">→</span></button>
            </form>
        </div>

        <aside class="contact-details">
            <p class="contact-details-label">MES RÉSEAUX</p>
            <p>Vous pouvez également me retrouver ici :</p>

            <div class="contact-links">
                <div class="contact-link">
                    <a class="contact-link-icon"
                       href="https://github.com/justinthomas22"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Ouvrir mon profil GitHub">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="">
                    </a>
                    <a class="contact-link-name"
                       href="https://github.com/justinthomas22"
                       target="_blank"
                       rel="noopener noreferrer">
                        GitHub — justinthomas22
                    </a>
                </div>

                <div class="contact-link">
                    <a class="contact-link-icon"
                       href="https://www.linkedin.com/in/thomas-justin-96809538a/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Ouvrir mon profil LinkedIn">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg" alt="">
                    </a>
                    <a class="contact-link-name"
                       href="https://www.linkedin.com/in/thomas-justin-96809538a/"
                       target="_blank"
                       rel="noopener noreferrer">
                        LinkedIn — Thomas JUSTIN
                    </a>
                </div>

                <div class="contact-link">
                    <a class="contact-link-icon contact-mail-icon"
                       href="mailto:thomasequihen@gmail.com"
                       aria-label="M'envoyer un e-mail">
                        <span aria-hidden="true">✉</span>
                    </a>
                    <a class="contact-link-name" href="mailto:thomasequihen@gmail.com">
                        thomasequihen@gmail.com
                    </a>
                </div>
            </div>
        </aside>
    </div>
</section>
{% endblock %}
