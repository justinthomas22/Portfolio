
{% extends 'base.html.twig' %}

{% block title %}Accueil - Mon Portfolio{% endblock %}

{% block body %}

<section class="hero" id="accueil">

    <div class="hero-content">

        <div class="hero-text">

            <p class="subtitle">
                ÉTUDIANT EN BUT INFORMATIQUE - 3ÈME ANNÉE
            </p>

            <h1>
                Bonjour, je suis <span id="typing"></span><span class="cursor">|</span>
            </h1>

            <p class="description">
                Passionné par le développement informatique,
                je conçois des applications web et souhaite
                approfondir mes connaissances dans les domaines
                du Web et de la science des données.
            </p>

            <p>
                Actuellement en troisième année de BUT Informatique,
                je souhaite poursuivre mes études en Master
                Informatique - Web et Science de Données.
            </p>

        </div>

        <div class="hero-image">
            <img src="{{ asset('images/image1.jpg') }}"
                 alt="Photo de Thomas JUSTIN">
        </div>

    </div>

</section>

<section class="projets-section" id="projets">

    <p class="subtitle">MES RÉALISATIONS</p>
    <h2>Mes projets</h2>
    <p class="projets-intro">
        Quelques projets réalisés pendant mon BUT Informatique.
    </p>

    <div class="projets-podium">

        <article class="projet-card">
            <span class="projet-numero">02</span>
            <h3>Doc2Quiz</h3>
            <p>Développement d'un outil pédagogique utilisant l'intelligence artificielle pour transformer des documents de cours en questionnaires interactifs.</p>
            <div class="techs">
                <span>Python</span>
                <span>IA</span>
                <span>Ollama</span>
                <span>Gradio</span>
                <span>NoSQL</span>
            </div>
            <a href="{{ path('projet_detail', {id: 'doc2quiz'}) }}" class="btn-projet">
                Détails <span aria-hidden="true">↗</span>
            </a>
        </article>

        <article class="projet-card">
            <span class="projet-numero">01</span>
            <h3>Application web API Vélo</h3>
            <p>Développement d'une application web permettant de consulter des données sportives, d'exploiter des statistiques et de réaliser des prédictions à partir de résultats anciens.</p>
            <div class="techs">
                <span>Node.js</span>
                <span>PHP</span>
                <span>API Rest</span>
                <span>PostgreSQL</span>
            </div>
            <a href="{{ path('projet_detail', {id: 'application-gestion'}) }}" class="btn-projet">
                Détails <span aria-hidden="true">↗</span>
            </a>
        </article>

        <article class="projet-card">
            <span class="projet-numero">03</span>
            <h3>Projet R2.03</h3>
            <p>Projet universitaire de programmation orientée objet.</p>
            <div class="techs">
                <span>Java</span>
                <span>POO</span>
            </div>
            <a href="{{ path('projet_detail', {id: 'r203'}) }}" class="btn-projet">
                Détails <span aria-hidden="true">↗</span>
            </a>
        </article>

    </div>

</section>

<section class="parcours-section" id="parcours">

    <div class="parcours-intro">
        <p class="subtitle">MON PARCOURS</p>
        <h2>Formation &amp; expérience</h2>
        <p>
            Un parcours orienté vers le développement web, la conception
            d'applications.
        </p>
    </div>

    <div class="parcours-list">
        <article class="parcours-item">
            <span class="parcours-date">EN COURS</span>
            <div>
                <p class="parcours-type">Formation</p>
                <h3>BUT Informatique — 3e année</h3>
                <p>
                    Approfondissement du développement web, de la programmation.
                </p>
            </div>
        </article>

        <article class="parcours-item">
            <span class="parcours-date">STAGE</span>
            <div>
                <p class="parcours-type">Expérience</p>
                <h3>Développement d'applications avec Symfony</h3>
                <p>
                    Découverte du développement d'applications dans un contexte
                    professionnel et mise en pratique de Symfony.
                </p>
            </div>
        </article>
    </div>

</section>

<section class="content-section" id="contact">

    <h2>Me contacter</h2>

    <p>Retrouve-moi sur mes réseaux professionnels :</p>

    <div class="social-links">

        <a href="https://github.com/justinthomas22"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Mon profil GitHub">

            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg"
                 alt="GitHub">
        </a>

        <a href="https://www.linkedin.com/in/thomas-justin-96809538a/"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Mon profil LinkedIn">

            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg"
                 alt="LinkedIn">
        </a>

    </div>

</section>
<script>
    const nom = "Thomas JUSTIN.";
    const element = document.getElementById("typing");

    let i = 0;

    function ecrire() {
        if (i < nom.length) {
            element.innerHTML += nom[i];
            i++;
            setTimeout(ecrire, 180);
        }
    }

    ecrire();
</script>

{% endblock %}
