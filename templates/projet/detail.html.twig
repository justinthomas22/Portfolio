
{% extends 'base.html.twig' %}

{% block title %}{{ projet.titre }} - Mon Portfolio{% endblock %}

{% block body %}

<section class="detail-projet">

    <a href="{{ path('app_home') }}" class="btn-retour retour">
        ← Retour aux projets
    </a>

    <p class="subtitle">DÉTAIL DU PROJET</p>

    <div class="detail-intro">
        <div>
            <h1>{{ projet.titre }}</h1>

            <p class="description">
                {{ projet.description }}
            </p>
        </div>

        {% if projet.image %}
            <img class="projet-image"
                 src="{{ asset('images/' ~ projet.image) }}"
                 alt="Illustration du projet {{ projet.titre }}">
        {% endif %}
    </div>

    <div class="detail-layout">
        <div class="detail-main">
            <div class="detail-bloc">
                <h2>Présentation du projet</h2>
                <p>
                    {{ projet.presentation|nl2br }}
                </p>
            </div>

            <div class="detail-bloc">
                <h2>Compétences acquises</h2>
                <p>
                    {{ projet.competences|nl2br }}
                </p>
            </div>
        </div>

        <aside class="detail-meta">
            <div class="detail-bloc">
                <h2>Technologies utilisées</h2>

                <div class="techs">
                    {% for technologie in projet.technologies %}
                        <span>{{ technologie }}</span>
                    {% endfor %}
                </div>
            </div>

            <div class="detail-bloc">
                <h2>Temps consacré</h2>
                <p>{{ projet.temps }}</p>
            </div>

            <div class="detail-bloc">
                <h2>Nombre de personnes</h2>
                <p>{{ projet.personnes }} personne{% if projet.personnes > 1 %}s{% endif %}</p>
            </div>
        </aside>
    </div>

    <a href="{{ projet.github }}"
       target="_blank"
       rel="noopener noreferrer"
       class="btn-projet">
        Voir le code sur GitHub →
    </a>

</section>

{% endblock %}
