
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon Portfolio{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>

<header>
    <nav>
        <a href="{{ path('app_home') }}" class="logo">PORTFOLIO.</a>

        <div class="nav-links">
            <a href="{{ path('app_home') }}#accueil">Accueil</a>
            <a href="{{ path('app_home') }}#parcours">À propos</a>
            <a href="{{ path('app_home') }}#competences">Compétences</a>
            <a href="{{ path('app_home') }}#projets">Projets</a>
            <a href="{{ path('app_contact') }}">Contact</a>
            <a href="{{ path('app_cv') }}" class="nav-cv">CV</a>
        </div>
    </nav>
</header>

<main>
    {% block body %}{% endblock %}
</main>

<footer>
    <div class="footer-content">
        <a href="{{ path('app_home') }}" class="logo">PORTFOLIO.</a>
        <p>© {{ "now"|date("Y") }} Thomas JUSTIN</p>
    </div>
</footer>

</body>
</html>
